# ============================================================
# 复制本文件为 .env 后按需修改，.env 已被 .gitignore 忽略，勿提交真实密钥
# ============================================================

# ---------- 数据库（MySQL >= 8）----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=traffic_light_system
DB_USER=root
DB_PASSWORD=

# ---------- 缓存（Redis >= 5，可选；缺失时后端降级启动）----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 服务端口 ----------
PORT=3001
WS_PORT=3002
NODE_ENV=development

# ---------- 自适应调度：低车流快速切绿 ----------
# 统计窗口秒数
LOW_FLOW_WINDOW_SECONDS=3
# 窗口内车辆数低于该值触发提前结束绿灯
LOW_FLOW_THRESHOLD=12
# 触发后绿灯的最短保底秒数
MIN_GREEN_FLOOR_SECONDS=5

# ---------- AI 动态红绿灯 ----------
# 统一走 OpenAI 兼容协议，三种模式可选：
#   deepseek —— DeepSeek 云端 API（默认）
#   zhipu    —— 智谱 GLM 云端 API
#   llamacpp —— 本地 llama.cpp（llama-server），离线可用、免密钥
AI_PROVIDER=deepseek

# 备用 provider：主 provider 超时/熔断/未启动时自动接管，实现云端与本地互为备份。
# 留空表示不启用回退。典型组合：
#   AI_PROVIDER=llamacpp + AI_FALLBACK_PROVIDER=deepseek   （本地优先，云端兜底）
#   AI_PROVIDER=deepseek + AI_FALLBACK_PROVIDER=llamacpp   （云端优先，本地兜底）
# 两者都不可用时，系统自动退回规则配时，红绿灯调度不受影响。
AI_FALLBACK_PROVIDER=

# AI 建议刷新间隔（毫秒）
AI_ADVICE_INTERVAL_MS=10000
# 单次 AI 请求超时（毫秒）；留空时按 provider 默认值（云端 12000，本地 llamacpp 30000）
# 本地的 30s 是为「模型尚未加载进显存的第一个请求」留余量，GPU 卸载下实际推理仅 1~3s。
# 服务常驻预热后建议设 15000，可加快 llama-server 故障时的主备切换。
AI_TIMEOUT_MS=

# 配时硬约束
MAX_GREEN_SECONDS=120
MIN_YELLOW_SECONDS=3
MAX_YELLOW_SECONDS=5
CYCLE_MAX_SECONDS=180

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM（AI_PROVIDER=zhipu 时启用）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# llama.cpp 本地推理（AI_PROVIDER=llamacpp 时启用）
# 先启动服务（GPU 卸载，-ngl 为卸载到显存的层数）：
#   llama-server -m model.gguf -c 4096 -ngl 99 --host 127.0.0.1 --port 8080
# llama-server 原生提供 OpenAI 兼容端点，故无需额外适配层
# 速度取决于 -ngl：全量卸载到 GPU 时 7B Q4 约 1~3s；纯 CPU（-ngl 0）会慢一个数量级
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# 本地模型名按实际加载的 GGUF 填写；若 llama-server 以单模型启动，此值通常可任填
LLAMACPP_MODEL=local-gguf
# 本地服务一般无鉴权，留空即可；若用 --api-key 启动则填写
LLAMACPP_API_KEY=

# ---------- JWT ----------
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=24h

# ---------- 前端演示参数（Vite 仅识别 VITE_ 前缀）----------
VITE_LOW_FLOW_WINDOW_SECONDS=1
VITE_LOW_FLOW_THRESHOLD=8
VITE_MIN_GREEN_FLOOR_SECONDS=5
VITE_DEMO_ARRIVAL_SCALE_STRAIGHT=1
VITE_DEMO_ARRIVAL_SCALE_LEFT=1
VITE_DEMO_RELEASE_STRAIGHT_SCALE=1
VITE_DEMO_RELEASE_LEFT_SCALE=1
