  <div class="title">核心模块 ②：自适应配时（低车流快速切绿）</div>
  <div class="row" style="margin-top:14px;">
    <div style="flex:0 0 50%;background:var(--ink);border-radius:10px;padding:18px;">
      <div style="color:#93C5FD;font-size:14px;font-weight:700;margin-bottom:10px;">触发逻辑（伪代码）</div>
      <pre style="background:#1E293B;border-radius:6px;padding:14px;color:#E2E8F0;font-family:var(--font-mono);font-size:11px;line-height:1.5;margin:0;">// 每秒 tick：
const windowSec = env.LOW_FLOW_WINDOW_SECONDS;   // 默认 3s
const threshold = env.LOW_FLOW_THRESHOLD;          // 默认 12 辆
const floorSec  = env.MIN_GREEN_FLOOR_SECONDS;     // 默认 5s

const recentCount = flowStats.sumLast(windowSec);
if (elapsedGreen &gt;= floorSec &amp;&amp; recentCount &lt; threshold) {
  // 车流低 → 提前结束当前绿灯
  phase.remaining = 1;
  socket.broadcast('light_status_update', {...});
}</pre>
    </div>
    <div class="col" style="margin-left:18px;">
      <div class="card">
        <div style="font-size:14px;font-weight:700;">可调参数 (.env + Vite)</div>
        <table style="width:100%;font-size:11px;font-family:var(--font-mono);margin-top:10px;">
          <tr><td style="padding:4px 0;color:var(--ink);font-weight:700;">LOW_FLOW_WINDOW_SECONDS</td><td style="text-align:right;color:var(--blue);font-weight:700;">3</td><td style="padding-left:14px;color:var(--muted);font-family:var(--font-h);">统计窗口</td></tr>
          <tr><td style="padding:4px 0;color:var(--ink);font-weight:700;">LOW_FLOW_THRESHOLD</td><td style="text-align:right;color:var(--blue);font-weight:700;">12</td><td style="padding-left:14px;color:var(--muted);font-family:var(--font-h);">触发阈值</td></tr>
          <tr><td style="padding:4px 0;color:var(--ink);font-weight:700;">MIN_GREEN_FLOOR_SECONDS</td><td style="text-align:right;color:var(--blue);font-weight:700;">5</td><td style="padding-left:14px;color:var(--muted);font-family:var(--font-h);">绿灯保底</td></tr>
          <tr><td style="padding:4px 0;color:var(--ink);font-weight:700;">VITE_*_SCALE</td><td style="text-align:right;color:var(--blue);font-weight:700;">—</td><td style="padding-left:14px;color:var(--muted);font-family:var(--font-h);">前端演示倍率</td></tr>
        </table>
