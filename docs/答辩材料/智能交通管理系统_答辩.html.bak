<div class="kbd-hint" id="kbd"><kbd>←</kbd> <kbd>→</kbd> 翻页   ·   <kbd>F</kbd> 全屏   ·   <kbd>Home</kbd> 首页</div>

<script>
(function(){
  var slides = document.querySelectorAll('.slide');
  var total = slides.length;
  var info = document.getElementById('page-info');
  var kbd = document.getElementById('kbd');
  var saved = parseInt(localStorage.getItem('deck-page') || '1', 10);
  var cur = Math.min(Math.max(saved, 1), total);

  function show(n){
    cur = Math.min(Math.max(n, 1), total);
    slides.forEach(function(s, i){
      s.classList.toggle('active', i === cur - 1);
    });
    info.textContent = cur + ' / ' + total;
    localStorage.setItem('deck-page', cur);
  }

  show(cur);
  setTimeout(function(){ kbd.classList.add('show'); }, 600);
  setTimeout(function(){ kbd.classList.remove('show'); }, 4000);

  document.addEventListener('keydown', function(e){
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') { show(cur + 1); e.preventDefault(); }
    else if (e.key === 'ArrowLeft' || e.key === 'PageUp') { show(cur - 1); e.preventDefault(); }
    else if (e.key === 'Home') { show(1); e.preventDefault(); }
    else if (e.key === 'End') { show(total); e.preventDefault(); }
    else if (e.key === 'f' || e.key === 'F') {
      if (document.fullscreenElement) document.exitFullscreen();
      else document.documentElement.requestFullscreen();
    } else if (/^[0-9]$/.test(e.key)) { show(parseInt(e.key, 10)); e.preventDefault(); }
  });

  document.addEventListener('click', function(e){
    if (e.target.tagName === 'A') return;
    var x = e.clientX / window.innerWidth;
    if (x > 0.6) show(cur + 1);
    else if (x < 0.4) show(cur - 1);
  });

  // touch swipe
  var tx = 0;
  document.addEventListener('touchstart', function(e){ tx = e.touches[0].clientX; }, {passive:true});
  document.addEventListener('touchend', function(e){
    var dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
  }, {passive:true});
})();
</script>
</body>
